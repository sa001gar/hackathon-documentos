# --- Database ---
# SQLite by default for zero-config dev. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documentos
DATABASE_URL=sqlite:///./documentos.db

# --- Auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Engine ---
# auto | ollama | openai | mock
# "auto" tries Ollama (local Gemma) and falls back to the deterministic mock provider,
# so the app is always demoable even without a model installed.
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
# Gemma model served by Ollama (e.g. gemma3, gemma3:4b, gemma3:27b).
# When Gemma 4 becomes available in Ollama, just set GEMMA_MODEL=gemma4
GEMMA_MODEL=gemma3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT=180
AI_MAX_RETRIES=2
# Directory with overrideable prompt templates (.md). Falls back to built-in prompts.
PROMPTS_DIR=../../packages/prompts

# --- App ---
CORS_ORIGINS=http://localhost:5173
EXPORT_DIR=./exports
