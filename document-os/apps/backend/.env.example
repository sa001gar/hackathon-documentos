# --- Database ---
# SQLite by default for zero-config LOCAL dev — no database server needed.
# In deployment (Dokploy), set the external managed Postgres URL instead:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/documentos
DATABASE_URL=sqlite:///./documentos.db
# Optional/reserved (job runner is in-process — no Redis required):
# REDIS_URL=redis://host:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Engine ---
# auto | google | ollama | openai | mock
# "auto" picks: Google AI (if GEMINI_API_KEY set) → Ollama (if running) → mock (offline demo).
AI_PROVIDER=auto

# Option 1 — Google AI SDK: hosted Gemma 4 (recommended for the hackathon)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Option 2 — Ollama: Gemma running locally (`ollama pull gemma3`)
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3

# Option 3 — any OpenAI-compatible server (vLLM, llama.cpp, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

AI_REQUEST_TIMEOUT=180
AI_MAX_RETRIES=2
# Directory with overrideable prompt templates (.md). Falls back to built-in prompts.
PROMPTS_DIR=../../packages/prompts

# --- App ---
CORS_ORIGINS=http://localhost:5173
EXPORT_DIR=./exports
