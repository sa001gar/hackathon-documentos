{
  "name": "document-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI Document Operating System — hierarchical, agent-driven document workspace powered by Gemma",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter @documentos/frontend dev",
    "dev:backend": "pnpm --filter @documentos/backend dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @documentos/backend test",
    "seed": "pnpm --filter @documentos/backend run seed",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
