# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

# Layer caching: copy dependency manifests first (rarely change)
COPY apps/backend/pyproject.toml apps/backend/uv.lock ./apps/backend/
COPY packages/prompts/ ./packages/prompts/

RUN uv sync --directory apps/backend --frozen --no-dev

# Then copy the rest of the application source
COPY apps/backend ./apps/backend
COPY packages/prompts ./packages/prompts

# ── production runtime image ──────────────────────────────────────
FROM python:3.12-slim-bookworm

# Create non-root user (least privilege)
RUN groupadd --system --gid 1001 app && \
    useradd --system --uid 1001 --gid app --create-home app

# WORKDIR must be /app/apps/backend so that `import app` resolves —
# the `app` package lives at apps/backend/app/ and Python finds it
# as a subdirectory of the current working directory.
WORKDIR /app/apps/backend

# Copy application code + venv (the .venv/ was created by uv sync in the builder)
COPY --from=builder /app/apps/backend /app/apps/backend

COPY --from=builder /app/packages/prompts /app/packages/prompts

# Pre-create export/data directories so the non-root app user owns them
# (Docker volumes inherit these permissions on first mount).
RUN mkdir -p /app/exports /app/data && chown -R app:app /app/exports /app/data

ENV \
    # Prepend venv to PATH so `uvicorn` etc. are available
    PATH="/app/apps/backend/.venv/bin:$PATH" \
    # Python: unbuffered stdout/stderr for Docker logging
    PYTHONUNBUFFERED=1 \
    # Python: don't write .pyc files (read-only container)
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

USER app:app

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health',timeout=3).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
