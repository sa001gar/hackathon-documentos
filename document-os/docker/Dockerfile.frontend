# Frontend image: build the SPA, serve it with a tiny Node static server.
# No nginx — Dokploy's Traefik handles routing/TLS ("/" → this, "/api" → backend).
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml ./
COPY packages/shared-types ./packages/shared-types
COPY packages/utils ./packages/utils
COPY apps/frontend ./apps/frontend

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @documentos/frontend build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/apps/frontend/dist ./dist
COPY docker/serve.mjs ./serve.mjs

EXPOSE 3000
CMD ["node", "serve.mjs"]
